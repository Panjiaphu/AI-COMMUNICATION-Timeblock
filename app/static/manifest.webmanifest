{
  "id": "/",
  "name": "Timeblock",
  "short_name": "Timeblock",
  "description": "Timeblock member and business communication, productivity, market data and AI tools.",
  "start_url": "/assistant?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f7f8f2",
  "theme_color": "#0f4f44",
  "lang": "vi",
  "dir": "ltr",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    {
      "src": "/static/img/timeblock-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/img/timeblock-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/img/timeblock-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Messages",
      "short_name": "Messages",
      "url": "/assistant?mode=messages&source=pwa",
      "description": "Open Timeblock messages",
      "icons": [{"src": "/static/img/timeblock-icon-192.png", "sizes": "192x192", "type": "image/png"}]
    },
    {
      "name": "Notifications",
      "short_name": "Alerts",
      "url": "/assistant?mode=alerts&source=pwa",
      "description": "Open Timeblock notifications",
      "icons": [{"src": "/static/img/timeblock-icon-192.png", "sizes": "192x192", "type": "image/png"}]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "url": "/app-settings?source=pwa",
      "description": "Open Timeblock app settings",
      "icons": [{"src": "/static/img/timeblock-icon-192.png", "sizes": "192x192", "type": "image/png"}]
    }
  ]
}
