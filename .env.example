APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-change-me-change-me-change-me
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Explicitly opt in to the static local/test session token. Never enable in production.
ALLOW_DEVELOPMENT_SESSION_FALLBACK=true

# Timeblock Control Plane. Leave empty only with the explicit local/test fallback above.
TIMEBLOCK_API_URL=
TIMEBLOCK_API_KEY=

# Browser handoff origins are the exact Timeblock pages allowed to postMessage credentials to Guilua.
ALLOWED_TIMEBLOCK_HANDOFF_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# WebSocket Origin is Guilua itself because the socket is opened by the Guilua page.
ALLOWED_WEBSOCKET_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ALLOW_MISSING_WEBSOCKET_ORIGIN=true
WEBSOCKET_AUTH_TIMEOUT_SECONDS=5
MAX_AUTH_EVENT_BYTES=16384
CONNECTION_STALE_SECONDS=120
RECONNECT_TOKEN_SECONDS=300
ENDED_SESSION_CACHE_SECONDS=600
IDEMPOTENCY_CACHE_SECONDS=1800
