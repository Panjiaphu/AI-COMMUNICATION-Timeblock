APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-change-me-change-me-change-me
PUBLIC_BASE_URL=http://127.0.0.1:8000
TIMEBLOCK_APP_URL=http://127.0.0.1:5000
DEPLOYMENT_VERSION=development

# Explicitly opt in to the static local/test session token. Never enable in production.
ALLOW_DEVELOPMENT_SESSION_FALLBACK=true

# Timeblock Control Plane. Leave empty only with the explicit local/test fallback above.
TIMEBLOCK_API_URL=
TIMEBLOCK_API_KEY=
TIMEBLOCK_TIMEOUT_SECONDS=5
TIMEBLOCK_PROXY_TIMEOUT_SECONDS=120
GUILUA_CLIENT_ID=guilua
GUILUA_SESSION_COOKIE=guilua_session
GUILUA_PENDING_AUTHORIZATION_COOKIE=guilua_auth_nonce
GUILUA_SESSION_TTL_SECONDS=14400
GUILUA_PENDING_AUTHORIZATION_TTL_SECONDS=120
GUILUA_SESSION_MAX_ENTRIES=10000
GUILUA_PENDING_AUTHORIZATION_MAX_ENTRIES=2000
GUILUA_AUTHORIZATION_START_RATE_LIMIT_COUNT=12
GUILUA_AUTHORIZATION_START_RATE_LIMIT_WINDOW_SECONDS=60
ALLOW_MISSING_BFF_ORIGIN=true
MESSAGING_REALTIME_ENABLED=true
MESSAGING_MAILBOX_LOCK_ENABLED=true
MESSAGING_ADVANCED_ATTACHMENTS_ENABLED=true
GROUP_TRANSLATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_REALTIME_TRANSLATION_MODEL=gpt-realtime-translate
GROUP_TRANSLATION_MAX_TARGETS=2
GROUP_V3_ENABLED=false
GROUP_HANDOFF_AUDIENCE=ai-communication-group-v3
GROUP_HANDOFF_MAX_BYTES=8192
DATABASE_URL=sqlite:///./.data/ai-communication.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
GROUP_MESSAGE_ENCRYPTION_KEY=
GROUP_ATTACHMENT_MAX_BYTES=5242880
GROUP_MEDIA_ENABLED=false
GROUP_LIVEKIT_URL=
GROUP_LIVEKIT_API_KEY=
GROUP_LIVEKIT_API_SECRET=
GROUP_LIVEKIT_REGION=Singapore
GROUP_LIVEKIT_TOKEN_TTL_SECONDS=300
GROUP_MEDIA_MAX_PARTICIPANTS=8
GROUP_RADIO_FLOOR_LEASE_SECONDS=15
GROUP_RADIO_MAX_BURST_SECONDS=30
GROUP_RADIO_MAX_ROOMS=20

# Browser handoff origins are the exact Timeblock pages allowed to postMessage credentials to Guilua.
ALLOWED_TIMEBLOCK_HANDOFF_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# WebSocket Origin is Guilua itself because the socket is opened by the Guilua page.
ALLOWED_WEBSOCKET_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ALLOW_MISSING_WEBSOCKET_ORIGIN=true
WEBSOCKET_AUTH_TIMEOUT_SECONDS=5
MAX_AUTH_EVENT_BYTES=16384
CONNECTION_STALE_SECONDS=120
RECONNECT_TOKEN_SECONDS=300
ENDED_SESSION_CACHE_SECONDS=600
IDEMPOTENCY_CACHE_SECONDS=1800
